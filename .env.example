# LuxSequencer - Environment Variables

# Debug Mode - General
# Set to 'true' to enable debug overlay and console logging
VITE_DEBUG_MODE=false

# Debug Categories (fine-grained control)
# Sequencer timing and pattern loading
VITE_DEBUG_SEQUENCER=false

# Pattern animation and interpolation
VITE_DEBUG_ANIMATION=false

# MIDI messages and mappings
VITE_DEBUG_MIDI=false

# Property sequencer and keyframes
VITE_DEBUG_PROPERTY_SEQUENCER=false

# Development Settings
# Set to 'true' for development mode
VITE_DEV_MODE=true

# API Keys (if needed in the future)
# VITE_GEMINI_API_KEY=your_api_key_here

# Performance Settings
# Maximum FPS for rendering (default: 60)
VITE_MAX_FPS=60

# MIDI Settings
# Enable/disable MIDI auto-connect on startup
VITE_MIDI_AUTO_CONNECT=true

# Transitional Legacy Controls Flag
# Temporary escape hatch for old renderer controlSchema entries with type:'custom'
# Recommended: false
VITE_ALLOW_LEGACY_CUSTOM_CONTROLS=false

# Community Renderer Signature Trust Store
# JSON array with trusted public keys (SPKI base64)
# Example:
# VITE_COMMUNITY_TRUSTED_PUBLIC_KEYS=[{"id":"community-key-2026-q1","spkiBase64":"MIIB...","status":"active","notBefore":"2026-01-01T00:00:00Z","notAfter":"2026-12-31T23:59:59Z","replacedBy":"community-key-2027-q1"}]
VITE_COMMUNITY_TRUSTED_PUBLIC_KEYS=[]

# Comma-separated list of revoked key IDs (takes precedence over key status)
# Example: VITE_COMMUNITY_REVOKED_PUBLIC_KEY_IDS=community-key-2025-q4,community-key-2026-q1
VITE_COMMUNITY_REVOKED_PUBLIC_KEY_IDS=

# Optional remote trust store distribution endpoint
# Expected payload: {"schemaVersion":"1.0.0","version":"1.0.0","keys":[...],"revokedKeyIds":[...]}
VITE_COMMUNITY_TRUST_STORE_URL=

# Timeout (ms) for remote trust store fetch
VITE_COMMUNITY_TRUST_STORE_FETCH_TIMEOUT_MS=2500

# Runtime TTL (ms) before re-fetching trust store snapshot
VITE_COMMUNITY_TRUST_STORE_CACHE_TTL_MS=300000

# Optional minimum accepted trust store version
VITE_COMMUNITY_TRUST_STORE_MIN_VERSION=

# Require cryptographic signature for remote trust store payloads
VITE_COMMUNITY_TRUST_STORE_REQUIRE_SIGNATURE=true

# Root keys used to verify remote trust store metadata signature
# Example:
# VITE_COMMUNITY_TRUST_STORE_ROOT_PUBLIC_KEYS=[{"id":"trust-root-2026-q1","spkiBase64":"MIIB...","status":"active"}]
VITE_COMMUNITY_TRUST_STORE_ROOT_PUBLIC_KEYS=[]

# Comma-separated revoked root key IDs
VITE_COMMUNITY_TRUST_STORE_REVOKED_ROOT_KEY_IDS=

# Grace period (ms) to allow recently expired root keys during key rotation
# Default: 604800000 (7 days)
VITE_COMMUNITY_TRUST_STORE_ROOT_ROTATION_GRACE_MS=604800000

# Optional endpoint for centralized revocation deltas (signed metadata)
VITE_COMMUNITY_TRUST_STORE_REVOCATION_URL=

# Runtime TTL (ms) for revocation snapshot fetched from centralized endpoint
VITE_COMMUNITY_TRUST_STORE_REVOCATION_CACHE_TTL_MS=120000

# External marketplace workers base URL
# Uses core Vite same-origin proxy -> http://localhost:4174
VITE_MARKETPLACE_CORE_RENDERERS_BASE_URL=/marketplace-core-renderers/src/renderers/
